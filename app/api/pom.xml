<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <!--
    API modular (monolito modular). Cada dominio e um modulo Maven com dependencias explicitas:
      shared     -> portas e adaptadores comuns (relogio/fuso, Discord, tratamento de erros)
      lembretes  -> dominio de lembretes (depende so de shared)
      tarefas    -> board de tarefas: squads, projetos, tarefas (depende so de shared)
      bootstrap  -> Spring Boot que junta os modulos e gera o jar executavel
    Modulo novo: criar a pasta, declarar em <modules> e como dependencia do bootstrap.
  -->
  <groupId>dev.api</groupId>
  <artifactId>api-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>
  <name>api</name>

  <modules>
    <module>shared</module>
    <module>lembretes</module>
    <module>tarefas</module>
    <module>bootstrap</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.api</groupId>
        <artifactId>api-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.api</groupId>
        <artifactId>api-lembretes</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.api</groupId>
        <artifactId>api-tarefas</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
